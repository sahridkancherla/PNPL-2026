*.pyc
*.pyo
__pycache__/
.venv/
.env/
*.json
lightning_logs/
*.ckpt

# Anchored with a leading slash: an unanchored "data/" also matches
# src/pnpl2026/data/ and silently drops the package from git.
/data/

# Keep the dirs, ignore their contents.
/runs/*
!/runs/.gitkeep
/logs/*
!/logs/.gitkeep
/submissions/*
!/submissions/.gitkeep

# The organisers' package (cli.handover pack): checkpoints, never in git.
/handover/
/handover_rebuild/

#!/bin/bash
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_type=RTX6000
#PBS -l walltime=08:00:00
#PBS -N pnpl-trial23-finetune
#PBS -j oe
#PBS -o logs/

# Trial 23, P6: one boundary / short-sentence specialist per non-comment line
# of configs/trial23/specialists.txt (cli.finetune), then everything
# `cli.boundary apply` needs from it: its chains38 dumps (validation, test)
# and its holdout CSV. From the repo root:
#
#     qsub -J 1-5 pbs/trial23_finetune.pbs
#     qsub -v RUN=<n> pbs/trial23_finetune.pbs     one line again
#     qsub -J 1-5 -v FINETUNE_ARGS="--epochs 2" pbs/trial23_finetune.pbs
#
# Fixed in advance: 3 epochs, 0.3x the parent's learning rate, TIMIT and
# MOCHA-TIMIT for half of every epoch's items, boundary features on.
#
# ⚠️ Needs on RDS: data/trial10_reference/, the t5 tables the parents trained
# on, data/trial23_training_scaler.npz, data/holdout/, the parents' checkpoints.

set -euo pipefail

cd "$HOME/PNPL-2026"
source "$HOME/.local/bin/env"
export PYTHONPATH="$PWD/src"
export PYTHONUNBUFFERED=1
export UV_OFFLINE=1 HF_HUB_OFFLINE=1

INDEX="${PBS_ARRAY_INDEX:-${RUN:-}}"
if [ -z "$INDEX" ]; then
    echo "no specialist chosen: submit with -J <range>, or -v RUN=<line of specialists.txt>" >&2
    exit 1
fi
read -r PARENT RUN_NAME <<< "$(grep -v '^#' configs/trial23/specialists.txt | sed -n "${INDEX}p")"
if [ -z "${PARENT:-}" ] || [ -z "${RUN_NAME:-}" ]; then
    echo "line ${INDEX} of configs/trial23/specialists.txt is not '<parent> <run name>'" >&2
    exit 1
fi
LIVE_LOG="logs/${PBS_JOBID%%[.[]*}.${RUN_NAME}.live.log"
echo "specialist ${INDEX}: ${PARENT} -> ${RUN_NAME}; live log: $LIVE_LOG"

{
    for needed in "$PARENT" data/trial10_reference/manifest.json data/trial23_training_scaler.npz \
                  data/holdout/COMPETITION_HOLDOUT/subj00_holdout01_sentence.npz; do
        if [ ! -e "$needed" ]; then
            echo "[preflight] not on RDS: $needed" >&2
            exit 1
        fi
    done
    STAGED_CACHE="${TMPDIR:?not set -- submit with qsub}/trial10_reference"
    SECONDS=0
    cp -r data/trial10_reference "$STAGED_CACHE"
    echo "[stage] cache copied in ${SECONDS}s"

    # shellcheck disable=SC2086
    uv run --frozen python -m pnpl2026.trial23.cli.finetune --parent "$PARENT" --run-name "$RUN_NAME" \
        --cache-dir "$STAGED_CACHE" --num-workers 8 --force ${FINETUNE_ARGS:-}

    # Its chains38 dumps (for the weight on MOCHA validation) and its holdout CSV.
    uv run --frozen python -m pnpl2026.trial23.cli.embed --ckpt "runs/${RUN_NAME}/best.ckpt" --holdout-dir "" \
        --protocol chains38 --partitions validation test --cache-dir "$STAGED_CACHE" --num-workers 8
    uv run --frozen python -m pnpl2026.trial23.cli.predict --ckpt "runs/${RUN_NAME}/best.ckpt" --holdout-dir data/holdout
} 2>&1 | tee "$LIVE_LOG"

#!/bin/bash
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_type=RTX6000
#PBS -l walltime=02:00:00
#PBS -N pnpl-trial9
#PBS -j oe
#PBS -o logs/

# Trial 9: the high-pass queue. One run and seed per line of
# configs/trial9/runs.txt -- H1 (0.5 Hz) x 3 seeds, then the H0 control x 3.
# From the repo root:
#
#     qsub -J 1-6 pbs/trial9.pbs      H1 and H0, all seeds
#     qsub -J 1-3 pbs/trial9.pbs      H1 only, against trial 8's E0 instead
#     qsub -v RUN=<n> pbs/trial9.pbs  one line again: a rerun, or a resume
#
# Walltime: trial 8's twelve runs, the same network, all early-stopped inside
# it (epochs 25-29). The filter is two FFTs per batch.
#
# ⚠️ num_workers in configs/trial9/hpc.yaml must match ncpus above.
#
# ⚠️ Submit from the repo root. `-o logs/` is resolved against where qsub ran.
#
# ⚠️ Nothing below downloads. Trial 8 reads trial 7's inputs unchanged, so if
# trial 7 has run on this account they are already there:
#     uv sync
#     data/word_embeddings_t5.npz     the semantic head's targets
#     data/trial7_continuous/         from pbs/trial7_build.pbs
# The preflight below names whichever is missing.

set -euo pipefail

cd "$HOME/PNPL-2026"
source "$HOME/.local/bin/env"
export PYTHONPATH="$PWD/src"
# Without this, python block-buffers stdout when it is not a terminal.
export PYTHONUNBUFFERED=1
# uv on a compute node must never try the network: offline, it fails at once
# and names the missing package, where online it would hang.
export UV_OFFLINE=1

# The array index when there is one, otherwise RUN from `qsub -v RUN=<n>`.
INDEX="${PBS_ARRAY_INDEX:-${RUN:-}}"
if [ -z "$INDEX" ]; then
    echo "no run chosen: submit with -J <range>, or -v RUN=<line of runs.txt>" >&2
    exit 1
fi

# Each line is "<config> <seed>".
read -r RUN_CONFIG SEED <<< "$(sed -n "${INDEX}p" configs/trial9/runs.txt)"
if [ -z "${RUN_CONFIG:-}" ] || [ ! -f "$RUN_CONFIG" ] || [ -z "${SEED:-}" ]; then
    echo "line ${INDEX} of configs/trial9/runs.txt is not '<config> <seed>'" >&2
    exit 1
fi

CONFIGS=(configs/base.yaml configs/trial9/trial9.yaml configs/trial9/hpc.yaml "$RUN_CONFIG")

LIVE_LOG="logs/${PBS_JOBID%%[.[]*}.$(basename "$RUN_CONFIG" .yaml)_s${SEED}.live.log"
echo "run ${INDEX}: ${RUN_CONFIG} seed ${SEED} -> live log: $LIVE_LOG"

# Check the inputs and the GPU in the first minute, not after hours of queue.
# Prints "<cache dir> <run name>" on stdout; everything else goes to stderr.
preflight() {
    uv run --frozen python - "${CONFIGS[@]}" <<'PYTHON'
import sys

import torch

from pnpl2026.trial9.config import load_trial9_config

cfg = load_trial9_config(*sys.argv[1:])

needed = [cfg.resolved_continuous_dir() / "manifest.json"]
if cfg.semantic_weight > 0:
    needed.append(cfg.resolved_word_embeddings())
missing = [str(path) for path in needed if not path.exists()]
if missing:
    sys.exit(f"[preflight] not on RDS: {missing}. Build or copy them first.")

# Exactly one. None means Lightning trains on the CPU; several means its
# devices=auto spreads the run over GPUs this job was never given.
n_gpus = torch.cuda.device_count()
if n_gpus != 1:
    sys.exit(f"[preflight] torch sees {n_gpus} GPUs; this job asked for 1.")

print(
    f"[preflight] {cfg.run_name} on {torch.cuda.get_device_name(0)} | "
    f"torch {torch.__version__} | CUDA {torch.version.cuda}",
    file=sys.stderr,
)
print(cfg.resolved_continuous_dir(), cfg.run_name)
PYTHON
}

# pipefail is set above, so a failure anywhere in here still fails the job
# through tee.
{
    # Captured first: an assignment carries the preflight's exit status, so a
    # failed check stops the job here. `read <<<` alone would swallow it
    PREFLIGHT=$(preflight)
    read -r CACHE_DIR BASE_NAME <<< "$PREFLIGHT"

    # Copy the continuous cache to the node's local disk. Every word's window
    # is a random-access slice; from RDS that is small reads over the network.
    STAGED_CACHE="${TMPDIR:?not set -- submit with qsub}/$(basename "$CACHE_DIR")"
    echo "[stage] $CACHE_DIR ($(du -sh "$CACHE_DIR" | cut -f1)) -> $STAGED_CACHE"
    SECONDS=0
    cp -r "$CACHE_DIR" "$STAGED_CACHE"
    echo "[stage] copied in ${SECONDS}s"

    # One more config layer, last so it wins: the staged cache, the seed, and
    # a run name carrying the seed, so three seeds never share a directory.
    # ⚠️ The run's config.yaml will name a $TMPDIR path gone after the job;
    # predict takes the run's own configs and reads the cache from RDS.
    STAGE_CONFIG="$TMPDIR/staged_run.yaml"
    printf 'continuous_dir: "%s"\nseed: %s\nrun_name: "%s_s%s"\n' \
        "$STAGED_CACHE" "$SEED" "$BASE_NAME" "$SEED" > "$STAGE_CONFIG"

    # --resume continues from last.ckpt, so a walltime kill just means
    # resubmitting the same line rather than starting over.
    uv run --frozen python -m pnpl2026.trial9.cli.train \
        --config "${CONFIGS[@]}" "$STAGE_CONFIG" --resume
} 2>&1 | tee "$LIVE_LOG"

#!/bin/bash
#PBS -l select=1:ncpus=8:mem=64gb
#PBS -l walltime=02:00:00
#PBS -N pnpl-trial23-cpu
#PBS -j oe
#PBS -o logs/

# Trial 23's CPU steps -- the testbed, the cross-subject votes, the gates --
# each with the standard arguments, so a step is one line. From the repo root:
#
#     qsub -v STEP=<step> pbs/trial23_cpu.pbs
#
#     testbed_check          does the testbed exist? (cli.testbed_check)
#     testbed                P1/SNF/P3/P8a tuned on ses-11, tested on ses-12 (cli.testbed)
#     cross_graph            those votes on the holdout, on BASE (cli.cross_graph)
#     boundary_diagnose      P6: is there a boundary gap? (cli.boundary diagnose)
#     boundary_apply         P6: the specialists on BASE's first/last rows (cli.boundary apply)
#     sequence_prior_check   P5: both priors, gated on MOCHA test (cli.sequence_prior check)
#     row_encoder            P2: train, gate on ses-12, embed the holdout (cli.row_encoder)
#     cross_graph_encoder    P2's embeddings in the votes, on BASE
#     cross_graph_megxl      P4's features in the votes, on BASE
#     recentre_reference     P8b: the training covariance (cli.recentre reference)
#     recentre_check         P8b: with against without, both held-out partitions
#     finish                 BASE through the hub correction and I3's lone rows -> <BASE stem>_hubh_lone.csv
#     robust                 robust's recipe rebuilt from the 23 members plus INCLUDE (a regex on the
#                            lines of configs/trial23/newmembers.txt) minus EXCLUDE (a regex on run
#                            names): blends 0.65/0.75/0.9, and 0.75 with SPW seeds 3-5, averaged, then
#                            finished -> submissions/ens_t23_<NAME>_robust_ts_hubh_lone.csv. About an hour.
#                            e.g. qsub -v STEP=robust,EXCLUDE=trial18_n_,NAME=noN pbs/trial23_cpu.pbs
#                                 qsub -v STEP=robust,INCLUDE=trial23_an_,NAME=anneal pbs/trial23_cpu.pbs
#                            MEMBERS_FILE=configs/trial23/fresh.txt starts from set B instead (its SPW
#                            is seeds 3-5 already, so its fourth mix repeats the 0.75 one).
#
# BASE is the holdout mix before the hub correction; default the 70.68
# file's, submissions/ens_t22_tc1b75_ts.csv. STEP_ARGS adds anything else.
# The local checks use the 70.68 mix's 23 members: configs/trial23/members.txt
# without trial 21's B. Minutes each; the testbed and the holdout readers the longest.
#
# ⚠️ Needs on RDS what each step reads -- the dumps (pbs/trial23_embed.pbs),
# the caches, data/holdout/, data/trial22_matches.json, the testbed map.

set -euo pipefail

cd "$HOME/PNPL-2026"
source "$HOME/.local/bin/env"
export PYTHONPATH="$PWD/src"
export PYTHONUNBUFFERED=1
export UV_OFFLINE=1 HF_HUB_OFFLINE=1
# One thread per core this job was given.
export OMP_NUM_THREADS=8

STEP="${STEP:?submit with -v STEP=<step>; the steps are listed in the header of this script}"
BASE="${BASE:-submissions/ens_t22_tc1b75_ts.csv}"
MEMBERS="$(grep -v '^#' configs/trial23/members.txt | grep -v '^trial21_b' | tr '\n' ' ')"
SPECIALISTS="$(grep -v '^#' configs/trial23/specialists.txt | awk '{print $2}' | tr '\n' ' ')"
LIVE_LOG="logs/${PBS_JOBID%%[.[]*}.trial23_${STEP}.live.log"
echo "step ${STEP}; base ${BASE}; live log: $LIVE_LOG"

# Every step runs trial 23's tools with the venv as locked.
tool() {
    uv run --frozen python -m "pnpl2026.trial23.cli.$1" "${@:2}"
}

# robust's four transduced mixes -- the members plus INCLUDE's new ones, minus EXCLUDE's --
# averaged, then hub + lone rows.
build_robust() {
    local name="${NAME:?submit with -v STEP=robust,NAME=<tag>[,INCLUDE=<regex>][,EXCLUDE=<regex>]}"
    local base added runs alternative inputs pair run needed
    base="$MEMBERS"
    if [ -n "${MEMBERS_FILE:-}" ]; then
        base="$(grep -v '^#' "$MEMBERS_FILE" | grep -v '^trial21_b' | tr '\n' ' ')"
    fi
    added=""
    if [ -n "${INCLUDE:-}" ]; then
        added="$(grep -v '^#' configs/trial23/newmembers.txt | grep -E "$INCLUDE" | tr '\n' ' ' || true)"
        if [ -z "$added" ]; then
            echo "[robust] INCLUDE=${INCLUDE} matches no line of configs/trial23/newmembers.txt" >&2
            return 1
        fi
        #every new member needs its holdout CSV and its validation dump before an hour is spent
        for run in $added; do
            for needed in "submissions/${run}_in_context_ts.csv" "runs/${run}/dumps/reference_validation.npz"; do
                if [ ! -e "$needed" ]; then
                    echo "[robust] not on RDS: $needed" >&2
                    return 1
                fi
            done
        done
    fi
    runs="$(echo $base $added | tr ' ' '\n' | grep -v -E "${EXCLUDE:-^$}" | tr '\n' ' ')"
    #SPW's seeds 3-5 (trial 20) in place of 0-2, for the fourth mix
    alternative="$(echo $runs | tr ' ' '\n' | sed -e 's/^trial19_spw_s0$/trial20_spw_s3/' -e 's/^trial19_spw_s1$/trial20_spw_s4/' -e 's/^trial19_spw_s2$/trial20_spw_s5/' | tr '\n' ' ')"
    echo "[robust] $(echo $runs | wc -w) members (added: ${added:-none}): $runs"
    for pair in 65:0.65 75:0.75 90:0.9; do
        tool transduce --inputs $(for r in $runs; do printf 'submissions/%s_in_context_ts.csv ' "$r"; done) --runs $runs \
            --pull 1.0 --blend "${pair##*:}" --check 0 --holdout-dir data/holdout --force \
            --out "submissions/ens_t23_${name}_tc1b${pair%%:*}_ts.csv"
    done
    tool transduce --inputs $(for r in $alternative; do printf 'submissions/%s_in_context_ts.csv ' "$r"; done) --runs $alternative \
        --pull 1.0 --blend 0.75 --check 0 --holdout-dir data/holdout --force --out "submissions/ens_t23_${name}_tc1b75_spwalt_ts.csv"
    tool ensemble --inputs "submissions/ens_t23_${name}_tc1b65_ts.csv" "submissions/ens_t23_${name}_tc1b75_ts.csv" \
        "submissions/ens_t23_${name}_tc1b90_ts.csv" "submissions/ens_t23_${name}_tc1b75_spwalt_ts.csv" \
        --out "submissions/ens_t23_${name}_robust_ts.csv" --force
    tool hubnorm_holdout --csv "submissions/ens_t23_${name}_robust_ts.csv" --method zscore --holdout-dir data/holdout --force
    tool lone_fill --csv "submissions/ens_t23_${name}_robust_ts_hubh.csv" --holdout-dir data/holdout --force \
        --lone-csvs submissions/trial15_i3_s{0,1,2}_in_context_ts.csv --lone-runs runs/trial15_i3_s{0,1,2}
}

{
    # shellcheck disable=SC2086
    case "$STEP" in
        testbed_check)        tool testbed_check ${STEP_ARGS:-} ;;
        testbed)              tool testbed --members $MEMBERS ${STEP_ARGS:-} ;;
        cross_graph)          tool cross_graph --base "$BASE" --holdout-dir data/holdout ${STEP_ARGS:-} ;;
        boundary_diagnose)    tool boundary diagnose --members $MEMBERS --holdout-dir data/holdout ${STEP_ARGS:-} ;;
        boundary_apply)       tool boundary apply --members $MEMBERS --specialists $SPECIALISTS --base "$BASE" \
                                  --holdout-dir data/holdout ${STEP_ARGS:-} ;;
        sequence_prior_check) tool sequence_prior check --members $MEMBERS ${STEP_ARGS:-} ;;
        row_encoder)          tool row_encoder --members $MEMBERS --base "$BASE" --holdout-dir data/holdout ${STEP_ARGS:-} ;;
        cross_graph_encoder)  tool cross_graph --base "$BASE" --holdout-dir data/holdout \
                                  --features data/trial23_row_encoder_holdout.npz \
                                  --settings data/trial23_row_encoder_settings.json ${STEP_ARGS:-} ;;
        cross_graph_megxl)    tool cross_graph --base "$BASE" --holdout-dir data/holdout \
                                  --features data/trial23_megxl_holdout.npz \
                                  --settings data/trial23_megxl_settings.json ${STEP_ARGS:-} ;;
        recentre_reference)   tool recentre reference ${STEP_ARGS:-} ;;
        recentre_check)       tool recentre check --members $MEMBERS ${STEP_ARGS:-} ;;
        finish)               tool hubnorm_holdout --csv "$BASE" --method zscore --holdout-dir data/holdout --force &&
                              tool lone_fill --csv "${BASE%.csv}_hubh.csv" --holdout-dir data/holdout --force \
                                  --lone-csvs submissions/trial15_i3_s{0,1,2}_in_context_ts.csv \
                                  --lone-runs runs/trial15_i3_s{0,1,2} ${STEP_ARGS:-} ;;
        robust)               build_robust ;;
        *)
            echo "unknown STEP ${STEP}; the steps are listed in this script's header" >&2
            exit 1 ;;
    esac
} 2>&1 | tee "$LIVE_LOG"

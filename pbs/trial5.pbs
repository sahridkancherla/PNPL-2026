#!/bin/bash
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=05:00:00
#PBS -N pnpl-trial5
#PBS -j oe
#PBS -o logs/

# Resources checked against Imperial's RCS job-sizing page on 2026-09-28. GPU
# jobs land in gpu72: one node, 1-64 ncpus, up to 920 GB, up to 72 h. An L40S
# node is 64 cores, 1 TB and 8 GPUs, so 8 cpus and 64 GB is one GPU's share.
#
# Walltime. The full 60 epochs are estimated at ~2 h, ~2.5 h if the L40S scales
# badly: ~550 steps of 512 per epoch at 0.18-0.24 s each, plus validation. That
# comes from timing this model on the laptop RTX 3060 and scaling by the two
# GPUs' specs -- it has not been timed on an L40S. 5 h is twice the slow case.
# The progress bar in the live log should read 4-5 it/s; under ~2 it/s the
# 60 epochs will not fit, and the job will need resubmitting (see --resume).
#
# ⚠️ num_workers in configs/trial5_hpc.yaml must match ncpus above. A mismatch
# either starves the GPU or wastes half the allocation.
#
# ⚠️ Submit from the repo root. `-o logs/` is resolved against the directory
# qsub ran in, not against the `cd` below.
#
# ⚠️ Nothing below downloads. Compute nodes have no outbound internet, so do
# these from a LOGIN node before the first submission:
#     uv sync                        builds .venv, torch cu128 included
#     data/trial1_cache/             the 18.3 GB cache, copied up to RDS
#     data/word_embeddings_t5.npz    the semantic head's targets, likewise
# The preflight below names whichever is missing.

set -euo pipefail

cd "$HOME/PNPL-2026"
source "$HOME/.local/bin/env"
export PYTHONPATH="$PWD/src"
# Without this, python block-buffers stdout when it is not a terminal.
export PYTHONUNBUFFERED=1
# uv on a compute node must never try the network: offline, it fails at once
# and names the missing package, where online it would hang.
export UV_OFFLINE=1

CONFIGS=(configs/base.yaml configs/trial5.yaml configs/trial5_hpc.yaml)

# PBS spools stdout on the compute node's local disk and only copies it to
# logs/ when the job exits, so the -o file cannot be tailed while running.
# tee to RDS instead -- this file updates live:
#     tail -f logs/<jobid>.live.log
LIVE_LOG="logs/${PBS_JOBID%%.*}.live.log"
echo "live log: $LIVE_LOG"

# Check the inputs and the GPU in the first minute, not after hours of queue.
# Paths come from the configs, so this script never holds a second copy of
# them. Prints the cache directory on stdout; everything else goes to stderr.
preflight() {
    uv run --frozen python - "${CONFIGS[@]}" <<'PYTHON'
import sys

import torch

from pnpl2026.trial5.config import load_trial5_config

cfg = load_trial5_config(*sys.argv[1:])

# The embedding table is only read when the semantic head is on.
needed = [cfg.resolved_cache_dir() / "manifest.json"]
if cfg.semantic_weight > 0:
    needed.append(cfg.resolved_word_embeddings())
missing = [str(path) for path in needed if not path.exists()]
if missing:
    sys.exit(f"[preflight] not on RDS: {missing}. Copy up from a login node.")

# Exactly one. None means Lightning trains on the CPU; several means its
# devices=auto spreads the run over GPUs this job was never given.
n_gpus = torch.cuda.device_count()
if n_gpus != 1:
    sys.exit(f"[preflight] torch sees {n_gpus} GPUs; this job asked for 1.")

device = torch.cuda.get_device_name(0)
print(
    f"[preflight] {device} | torch {torch.__version__} | CUDA {torch.version.cuda}",
    file=sys.stderr,
)
print(cfg.resolved_cache_dir())
PYTHON
}

# pipefail is set above, so a failure anywhere in here still fails the job
# through tee.
{
    CACHE_DIR=$(preflight)

    # Copy the cache to the node's local disk. Training reads 58 KB windows in
    # random order, ~280k of them an epoch; from RDS that is random reads over
    # the network, which starves the GPU and loads the shared filesystem.
    # $TMPDIR is local, 200-900 GB, and deleted when the job ends.
    STAGED_CACHE="${TMPDIR:?not set -- submit with qsub}/$(basename "$CACHE_DIR")"
    echo "[stage] $CACHE_DIR ($(du -sh "$CACHE_DIR" | cut -f1)) -> $STAGED_CACHE"
    SECONDS=0
    cp -r "$CACHE_DIR" "$STAGED_CACHE"
    echo "[stage] copied in ${SECONDS}s"

    # One more config layer, last so it wins, points the run at the copy.
    # ⚠️ So the run's config.yaml and provenance.json name a $TMPDIR path that
    # is gone once the job ends. evaluate and predict take the three configs
    # above and read the cache from RDS, so nothing downstream follows it.
    STAGE_CONFIG="$TMPDIR/staged_cache.yaml"
    printf 'cache_dir: "%s"\n' "$STAGED_CACHE" > "$STAGE_CONFIG"

    # --resume continues from last.ckpt, so a walltime kill just means
    # resubmitting this same script rather than starting over.
    uv run --frozen python -m pnpl2026.trial5.cli.train \
        --config "${CONFIGS[@]}" "$STAGE_CONFIG" --resume
} 2>&1 | tee "$LIVE_LOG"
